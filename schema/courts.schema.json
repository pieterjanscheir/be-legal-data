    "EnterpriseCourtDivision": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/CourtId",
          "description": "Stable id: the court `type` followed by its place, e.g. 'justice-of-the-peace-gent-1' or 'enterprise-court-gent-brugge'"
        },
        "arrondissement": {
          "$ref": "#/definitions/ArrondissementId",
          "description": "The judicial arrondissement the court lies in"
        },
        "name": {
