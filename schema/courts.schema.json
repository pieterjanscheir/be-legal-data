{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/be-legal-data/schema/courts.schema.json",
  "title": "be-legal-data: data/courts.json",
  "$ref": "#/definitions/CourtsFile",
  "definitions": {
    "CourtsFile": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Court"
      }
    },
    "Court": {
      "anyOf": [
        {
          "$ref": "#/definitions/JusticeOfThePeace"
        },
        {
          "$ref": "#/definitions/EnterpriseCourtDivision"
        }
      ]
    },
    "JusticeOfThePeace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable key, e.g. 'VredegerechtGent1' or 'OndernemingsrechtbankGentBrugge'",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "arrondissement": {
          "type": "string",
          "description": "Id of the judicial arrondissement the court lies in"
        },
        "name": {
          "$ref": "#/definitions/Translated",
          "description": "Place name of the court (or division)"
        },
        "address": {
          "$ref": "#/definitions/Address"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Contact"
          }
        },
        "bankAccount": {
          "type": "string"
        },
        "openingHours": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "description": "The court's own web page",
          "format": "uri"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          },
          "description": "Where the record's data comes from"
        },
        "type": {
          "type": "string",
          "const": "justice-of-the-peace"
        },
        "canton": {
          "type": "number",
          "description": "Canton number for places with several cantons (Gent 1–5, …)"
        }
      },
      "required": [
        "address",
        "arrondissement",
        "contacts",
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "Translated": {
      "type": "object",
      "properties": {
        "nl": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "nl",
        "fr",
        "de"
      ],
      "additionalProperties": false,
      "description": "A name in the three national languages"
    },
    "Address": {
      "type": "object",
      "properties": {
        "building": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "houseNumber": {
          "type": "string"
        },
        "postalCode": {
          "type": "string",
          "pattern": "^\\d{4}$"
        },
        "city": {
          "type": "string"
        }
      },
      "required": [
        "street",
        "postalCode",
        "city"
      ],
      "additionalProperties": false
    },
    "Contact": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "phone",
            "email"
          ]
        },
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "What the contact is for, e.g. 'griffie' or 'B-rol'"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The exact official page or file the data comes from",
          "format": "uri"
        },
        "retrieved": {
          "type": "string",
          "description": "Day the source was last checked, YYYY-MM-DD",
          "format": "date"
        }
      },
      "required": [
        "url",
        "retrieved"
      ],
      "additionalProperties": false,
      "description": "Where a record's data was taken from"
    },
    "EnterpriseCourtDivision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable key, e.g. 'VredegerechtGent1' or 'OndernemingsrechtbankGentBrugge'",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "arrondissement": {
          "type": "string",
          "description": "Id of the judicial arrondissement the court lies in"
        },
        "name": {
          "$ref": "#/definitions/Translated",
          "description": "Place name of the court (or division)"
        },
        "address": {
          "$ref": "#/definitions/Address"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Contact"
          }
        },
        "bankAccount": {
          "type": "string"
        },
        "openingHours": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "description": "The court's own web page",
          "format": "uri"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          },
          "description": "Where the record's data comes from"
        },
        "type": {
          "type": "string",
          "const": "enterprise-court"
        },
        "seat": {
          "$ref": "#/definitions/Translated",
          "description": "Place name of the court's seat; `name` is the division"
        }
      },
      "required": [
        "address",
        "arrondissement",
        "contacts",
        "id",
        "name",
        "seat",
        "type"
      ],
      "additionalProperties": false
    }
  }
}
