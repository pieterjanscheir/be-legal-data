{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/belgica/schema/courts.schema.json",
  "title": "belgica: data/courts.json",
  "$ref": "#/definitions/CourtsFile",
  "definitions": {
    "CourtsFile": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Court"
      }
    },
    "Court": {
      "type": "object",
      "properties": {
        "validFrom": {
          "type": "string",
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts.",
          "format": "date"
        },
        "validTo": {
          "type": "string",
          "description": "Last day the record applies, YYYY-MM-DD",
          "format": "date"
        },
        "id": {
          "$ref": "#/definitions/CourtId",
          "description": "Stable id: the type, then the place in the court's own language (Dutch for Brussels, with `-nl` or `-fr` for the courts split by language); a division or seat adds its place. 'justice-of-the-peace-gent-1', 'enterprise-court-gent-brugge', 'police-court-brussel-fr'"
        },
        "type": {
          "$ref": "#/definitions/CourtType"
        },
        "kind": {
          "type": "string",
          "enum": [
            "court",
            "division",
            "seat"
          ]
        },
        "court": {
          "$ref": "#/definitions/CourtId",
          "description": "For a division or seat: the court it belongs to"
        },
        "name": {
          "type": "object",
          "properties": {
            "nl": {
              "type": "string"
            },
            "fr": {
              "type": "string"
            },
            "de": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "The court's name as it publishes it, in each language it publishes in: 'Vredegerecht Gent 1', 'Tribunal de l'entreprise du Hainaut - division Mons'"
        },
        "judicialArea": {
          "$ref": "#/definitions/JudicialAreaId"
        },
        "arrondissement": {
          "$ref": "#/definitions/ArrondissementId",
          "description": "The arrondissement, for a court whose area is one arrondissement or lies within one"
        },
        "canton": {
          "$ref": "#/definitions/CantonId",
          "description": "For a justice of the peace: the canton it serves"
        },
        "cantons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CantonId"
          },
          "description": "For a court other than a justice of the peace: the cantons it covers, as the annex to the Judicial Code (art. 3–5) and art. 114 of the Code set them. A justice of the peace covers its `canton`; a division or seat has neither: see `court`."
        },
        "ecli": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The court's codes in European Case Law Identifiers (ECLI:BE:<code>:…), one per language it judges in; only codes seen in published decisions"
        },
        "address": {
          "$ref": "#/definitions/Address",
          "description": "Where the registry is; missing when the court publishes no single address"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Contact"
          }
        },
        "openingHours": {
          "type": "string",
          "description": "When the registry is open, in OpenStreetMap `opening_hours` syntax: 'Mo-Fr 08:30-12:30,13:30-16:00'. Only when the published text reads to it without doubt."
        },
        "openingHoursText": {
          "type": "object",
          "properties": {
            "nl": {
              "type": "string"
            },
            "fr": {
              "type": "string"
            },
            "de": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "The opening hours as the court publishes them, per language"
        },
        "website": {
          "type": "object",
          "properties": {
            "nl": {
              "$ref": "#/definitions/Url"
            },
            "fr": {
              "$ref": "#/definitions/Url"
            },
            "de": {
              "$ref": "#/definitions/Url"
            }
          },
          "additionalProperties": false,
          "description": "The court's page, per language"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          },
          "description": "The pages the record was read from"
        }
      },
      "required": [
        "id",
        "type",
        "kind",
        "name",
        "judicialArea",
        "contacts",
        "website",
        "sources"
      ],
      "additionalProperties": false,
      "description": "A court, a division of one (afdeling, division, Abteilung), or one of the seats of a justice of the peace that sits in several places."
    },
