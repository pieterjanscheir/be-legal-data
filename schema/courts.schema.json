{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/be-legal-data/schema/courts.schema.json",
  "title": "be-legal-data: data/courts.json",
  "$ref": "#/definitions/CourtsFile",
  "definitions": {
    "CourtsFile": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Court"
      }
    },
    "Court": {
      "anyOf": [
        {
          "$ref": "#/definitions/JusticeOfThePeace"
        },
        {
          "$ref": "#/definitions/EnterpriseCourtDivision"
        }
      ]
    },
    "JusticeOfThePeace": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/CourtId",
          "description": "Stable id: the court `type` followed by its place, e.g. 'justice-of-the-peace-gent-1' or 'enterprise-court-gent-brugge'"
        },
        "arrondissement": {
          "$ref": "#/definitions/ArrondissementId",
          "description": "The judicial arrondissement the court lies in"
        },
        "name": {
          "$ref": "#/definitions/Translated",
          "description": "Place name of the court (or division)"
        },
        "address": {
          "$ref": "#/definitions/Address"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Contact"
          }
        },
        "bankAccount": {
          "type": "string",
          "description": "IBAN in electronic format (no spaces), checksum verified; `formatIban` groups it by four",
          "pattern": "^BE\\d{14}$"
        },
        "openingHours": {
          "type": "string",
          "description": "When the registry is open, in OpenStreetMap `opening_hours` syntax, e.g. 'Mo-Fr 08:30-12:30,13:30-16:00'"
        },
        "website": {
          "type": "string",
          "description": "The court's own web page",
          "format": "uri"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          },
          "description": "Where the record's data comes from"
        },
        "type": {
          "type": "string",
          "const": "justice-of-the-peace"
        },
        "canton": {
          "$ref": "#/definitions/CantonId",
          "description": "The canton the justice of the peace serves"
        },
        "number": {
          "type": "number",
          "description": "The canton's number in places with several cantons (Gent 1–5, …). Part of the court's official name, so kept here; always equal to the canton's `number`."
        }
      },
      "required": [
        "address",
        "arrondissement",
        "canton",
        "contacts",
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "CourtId": {
      "type": "string",
      "enum": [
        "enterprise-court-gent-brugge",
        "enterprise-court-gent-dendermonde",
        "enterprise-court-gent-gent",
        "enterprise-court-gent-ieper",
        "enterprise-court-gent-kortrijk",
        "enterprise-court-gent-oostende",
        "enterprise-court-gent-oudenaarde",
        "enterprise-court-gent-veurne",
        "justice-of-the-peace-aalst-1",
        "justice-of-the-peace-aalst-2",
        "justice-of-the-peace-beveren-kruibeke-zwijndrecht",
        "justice-of-the-peace-brugge-1",
        "justice-of-the-peace-brugge-2",
        "justice-of-the-peace-brugge-3",
        "justice-of-the-peace-brugge-4",
        "justice-of-the-peace-deinze",
        "justice-of-the-peace-dendermonde",
        "justice-of-the-peace-eeklo",
        "justice-of-the-peace-gent-1",
        "justice-of-the-peace-gent-2",
        "justice-of-the-peace-gent-3",
        "justice-of-the-peace-gent-4",
        "justice-of-the-peace-gent-5",
        "justice-of-the-peace-geraardsbergen",
        "justice-of-the-peace-hamme",
        "justice-of-the-peace-herzele",
        "justice-of-the-peace-ieper",
        "justice-of-the-peace-izegem",
        "justice-of-the-peace-kortrijk-1",
        "justice-of-the-peace-kortrijk-2",
        "justice-of-the-peace-lokeren",
        "justice-of-the-peace-menen",
        "justice-of-the-peace-merelbeke-melle",
        "justice-of-the-peace-ninove",
        "justice-of-the-peace-oostende-1",
        "justice-of-the-peace-oostende-2",
        "justice-of-the-peace-oudenaarde",
        "justice-of-the-peace-poperinge",
        "justice-of-the-peace-roeselare",
        "justice-of-the-peace-sint-niklaas",
        "justice-of-the-peace-tielt",
        "justice-of-the-peace-torhout",
        "justice-of-the-peace-veurne",
        "justice-of-the-peace-waregem",
        "justice-of-the-peace-wetteren",
        "justice-of-the-peace-zelzate"
      ],
      "description": "Id of a record in data/courts.json"
    },
    "ArrondissementId": {
      "type": "string",
      "enum": [
        "antwerpen",
        "brabant-wallon",
        "brussel",
        "eupen",
        "hainaut",
        "leuven",
        "liege",
        "limburg",
        "luxembourg",
        "namur",
        "oost-vlaanderen",
        "west-vlaanderen"
      ],
      "description": "Id of a record in data/arrondissements.json"
    },
    "Translated": {
      "type": "object",
      "properties": {
        "nl": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "nl",
        "fr",
        "de"
      ],
      "additionalProperties": false,
      "description": "A name in the three national languages"
    },
    "Address": {
      "type": "object",
      "properties": {
        "building": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "houseNumber": {
          "type": "string"
        },
        "postalCode": {
          "type": "string",
          "pattern": "^\\d{4}$"
        },
        "city": {
          "type": "string"
        }
      },
      "required": [
        "street",
        "postalCode",
        "city"
      ],
      "additionalProperties": false
    },
    "Contact": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "phone"
            },
            "value": {
              "type": "string",
              "description": "E.164, e.g. '+3292343210'; `formatPhoneNumber` gives the Belgian national form",
              "pattern": "^\\+32\\d{8,9}$"
            },
            "label": {
              "$ref": "#/definitions/ContactLabel"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "email"
            },
            "value": {
              "type": "string",
              "description": "Lowercase",
              "format": "email"
            },
            "label": {
              "$ref": "#/definitions/ContactLabel"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ContactLabel": {
      "type": "string",
      "enum": [
        "griffie",
        "A-rol",
        "B-rol",
        "rechtspersonenregister"
      ],
      "description": "What a contact is for, in the courts' own (Dutch) terms: the registry ('griffie'), a specific roll of the enterprise court ('A-rol', 'B-rol') or its register of legal entities ('rechtspersonenregister'). No label: the court's general contact."
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The exact official page or file the data comes from",
          "format": "uri"
        },
        "retrieved": {
          "type": "string",
          "description": "Day the source was last checked, YYYY-MM-DD",
          "format": "date"
        }
      },
      "required": [
        "url",
        "retrieved"
      ],
      "additionalProperties": false,
      "description": "Where a record's data was taken from"
    },
