  "title": "belgica: data/municipalities.json",
  "$ref": "#/definitions/MunicipalitiesFile",
  "definitions": {
    "MunicipalitiesFile": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Municipality"
      }
    },
    "Municipality": {
      "type": "object",
      "properties": {
        "validFrom": {
          "type": "string",
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts.",
          "format": "date"
        },
        "validTo": {
          "type": "string",
          "description": "Last day the record applies, YYYY-MM-DD",
          "format": "date"
        },
        "id": {
          "$ref": "#/definitions/MunicipalityId",
          "description": "The municipality's Statbel REFNIS (NIS) code, e.g. '44021' for Gent"
        },
        "name": {
          "$ref": "#/definitions/Bilingual"
        },
        "province": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProvinceId"
            },
            {
              "type": "string",
              "const": "04000"
            }
          ],
          "description": "REFNIS code of the province. The 19 municipalities of the Brussels-Capital Region have no province and carry the region's code, '04000', as Statbel's files do."
        },
        "region": {
          "$ref": "#/definitions/RegionId",
          "description": "REFNIS code of the region"
        }
      },
      "required": [
        "id",
        "name",
        "province",
        "region"
      ],
      "additionalProperties": false
    },
