{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/be-legal-data/schema/arrondissements.schema.json",
  "title": "be-legal-data: data/arrondissements.json",
  "$ref": "#/definitions/ArrondissementsFile",
  "definitions": {
    "ArrondissementsFile": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Arrondissement"
      }
    },
    "Arrondissement": {
      "type": "object",
      "properties": {
        "validFrom": {
          "type": "string",
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts.",
          "format": "date"
        },
        "validTo": {
          "type": "string",
          "description": "Last day the record applies, YYYY-MM-DD",
          "format": "date"
        },
        "id": {
          "$ref": "#/definitions/ArrondissementId",
          "description": "Stable id from the local-language name, e.g. 'oost-vlaanderen'"
        },
        "name": {
          "$ref": "#/definitions/Translated"
        },
        "judicialArea": {
          "$ref": "#/definitions/JudicialAreaId",
          "description": "The judicial area the arrondissement belongs to"
        }
      },
      "required": [
        "id",
        "name",
        "judicialArea"
      ],
      "additionalProperties": false
    },
    "ArrondissementId": {
      "type": "string",
      "enum": [
        "antwerpen",
        "brabant-wallon",
        "brussel",
        "eupen",
        "hainaut",
        "leuven",
        "liege",
        "limburg",
        "luxembourg",
        "namur",
        "oost-vlaanderen",
        "west-vlaanderen"
      ],
      "description": "Id of a record in data/arrondissements.json"
    },
    "Translated": {
      "type": "object",
      "properties": {
        "nl": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "nl",
        "fr",
        "de"
      ],
      "additionalProperties": false,
      "description": "A name in the three national languages"
    },
    "JudicialAreaId": {
      "type": "string",
      "enum": [
        "antwerpen",
        "brussel",
        "gent",
        "liege",
        "mons"
      ],
      "description": "Id of a record in data/judicial-areas.json"
    }
  }
}
