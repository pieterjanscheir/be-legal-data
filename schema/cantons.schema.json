  "title": "be-legal-data: data/cantons.json",
  "$ref": "#/definitions/CantonsFile",
  "definitions": {
    "CantonsFile": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Canton"
      }
    },
    "Canton": {
      "type": "object",
      "properties": {
        "validFrom": {
          "type": "string",
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts.",
          "format": "date"
        },
        "validTo": {
          "type": "string",
          "description": "Last day the record applies, YYYY-MM-DD",
          "format": "date"
        },
        "id": {
          "$ref": "#/definitions/CantonId",
          "description": "Stable id from the local-language name, plus the number if any: 'gent-1', 'merelbeke-melle'"
        },
        "arrondissement": {
          "$ref": "#/definitions/ArrondissementId",
          "description": "The judicial arrondissement"
        },
        "name": {
          "$ref": "#/definitions/Bilingual",
          "description": "Name of the canton; usually the seat, but not always ('Oudergem' sits in Etterbeek)"
        },
        "number": {
          "type": "number",
          "description": "Canton number for places with several cantons (Gent 1–5, …)"
        },
        "seat": {
          "$ref": "#/definitions/Bilingual",
          "description": "Where the justice of the peace sits"
        },
        "municipalities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "municipality": {
                "$ref": "#/definitions/MunicipalityId"
              },
              "partial": {
                "type": "boolean"
              }
            },
            "required": [
              "municipality"
            ],
            "additionalProperties": false
          },
          "description": "The municipalities the canton covers. `partial` marks a municipality that is split over several cantons; `territory` then says which part belongs to this one."
        },
        "territory": {
          "$ref": "#/definitions/Bilingual",
          "description": "The canton's area, verbatim from the annex to the Judicial Code"
        },
        "legalBasis": {
          "$ref": "#/definitions/LegalBasis",
          "description": "Where the law defines the canton"
        }
      },
      "required": [
        "id",
        "arrondissement",
        "name",
        "seat",
        "municipalities",
        "territory",
        "legalBasis"
      ],
      "additionalProperties": false,
      "description": "A judicial canton: the area of one justice of the peace"
    },
