{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/belgica/schema/provinces.schema.json",
  "title": "belgica: data/provinces.json",
  "type": "array",
  "items": {
    "$ref": "#/definitions/Province"
  },
  "definitions": {
    "Province": {
      "type": "object",
      "properties": {
        "validFrom": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts."
        },
        "validTo": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "Last day the record applies, YYYY-MM-DD"
        },
        "id": {
          "$ref": "#/definitions/ProvinceId",
          "description": "The province's Statbel REFNIS code, e.g. '40000' for Oost-Vlaanderen"
        },
        "name": {
          "$ref": "#/definitions/Translated",
          "description": "The name as Statbel publishes it: 'Provincie Oost-Vlaanderen', 'Province de Flandre orientale', 'Provinz Ostflandern'"
        },
        "region": {
          "$ref": "#/definitions/RegionId",
          "description": "The region the province lies in"
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          },
          "description": "Statbel's REFNIS code list, and the day its content was first seen"
        }
      },
      "required": [
        "id",
        "name",
        "region",
        "sources"
      ],
      "additionalProperties": false,
      "description": "One of the ten provinces. The Brussels-Capital Region has none."
    },
    "Day": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "A day as YYYY-MM-DD"
    },
    "ProvinceId": {
      "type": "string",
      "enum": [
        "10000",
        "20001",
        "20002",
        "30000",
        "40000",
        "50000",
        "60000",
        "70000",
        "80000",
        "90000"
      ],
      "description": "Id of a record in data/provinces.json"
    },
    "Translated": {
      "type": "object",
      "properties": {
        "nl": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "nl",
        "fr",
        "de"
      ],
      "additionalProperties": false,
      "description": "A name in the three national languages"
    },
    "RegionId": {
      "type": "string",
      "enum": [
        "02000",
        "03000",
        "04000"
      ],
      "description": "Id of a record in data/regions.json"
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/definitions/Url",
          "description": "The exact official page or file the data comes from"
        },
        "retrieved": {
          "$ref": "#/definitions/Day",
          "description": "Day the source was last checked, YYYY-MM-DD"
        }
      },
      "required": [
        "url",
        "retrieved"
      ],
      "additionalProperties": false,
      "description": "Where a record's data was taken from"
    },
    "Url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "An http(s) URL"
    }
  }
}
