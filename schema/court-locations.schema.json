    "CourtLocation": {
      "type": "object",
      "properties": {
        "validFrom": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts."
        },
        "validTo": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "Last day the record applies, YYYY-MM-DD"
        },
        "id": {
          "$ref": "#/definitions/CourtId",
          "description": "The court's id: a court has one location, which takes its key"
        },
        "court": {
          "$ref": "#/definitions/CourtId",
          "description": "The court, or the seat of one, the point is the location of"
        },
        "ngiId": {
          "$ref": "#/definitions/NgiId",
          "description": "The NGI's identifier of the object (its `tgid`), e.g. '{453FCA79-B9F8-4194-875E-CD73D8AAAAA0}'"
        },
        "address": {
          "type": "string",
          "description": "The address the NGI gives with the point, as published: 'Neerstraat 11'"
        },
        "geometry": {
          "$ref": "#/definitions/Point",
          "description": "The point: WGS 84, longitude first, rounded to 7 decimals (about a centimetre)"
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "id",
        "court",
        "ngiId",
        "address",
        "geometry",
        "sources"
      ],
      "additionalProperties": false,
      "description": "Where a court is on the map: a point the National Geographic Institute (NGI) publishes for each justice of the peace. Only kept where the NGI's address and the court's own agree on the house number, so a point never sits at a building the court has left."
    },
