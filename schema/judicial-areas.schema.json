{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/belgica/schema/judicial-areas.schema.json",
  "title": "belgica: data/judicial-areas.json",
  "type": "array",
  "items": {
    "$ref": "#/definitions/JudicialArea"
  },
  "definitions": {
    "JudicialArea": {
      "type": "object",
      "properties": {
        "validFrom": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts."
        },
        "validTo": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "Last day the record applies, YYYY-MM-DD"
        },
        "id": {
          "$ref": "#/definitions/JudicialAreaId",
          "description": "Stable id from the local-language name, e.g. 'gent'"
        },
        "name": {
          "$ref": "#/definitions/Translated"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "description": "Area of a court of appeal (rechtsgebied): Antwerpen, Brussel, Gent, Luik or Bergen"
    },
    "Day": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "A day as YYYY-MM-DD"
    },
    "JudicialAreaId": {
      "type": "string",
      "enum": [
        "antwerpen",
        "brussel",
        "gent",
        "liege",
        "mons"
      ],
      "description": "Id of a record in data/judicial-areas.json"
    },
    "Translated": {
      "type": "object",
      "properties": {
        "nl": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "nl",
        "fr",
        "de"
      ],
      "additionalProperties": false,
      "description": "A name in the three national languages"
    }
  }
}
