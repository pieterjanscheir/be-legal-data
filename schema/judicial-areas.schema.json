{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/be-legal-data/schema/judicial-areas.schema.json",
  "title": "be-legal-data: data/judicial-areas.json",
  "$ref": "#/definitions/JudicialAreasFile",
  "definitions": {
    "JudicialAreasFile": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/JudicialArea"
      }
    },
    "JudicialArea": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/JudicialAreaId",
          "description": "Stable id from the local-language name, e.g. 'gent'"
        },
        "name": {
          "$ref": "#/definitions/Translated"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "description": "Area of a court of appeal (rechtsgebied): Antwerpen, Brussel, Gent, Luik or Bergen"
    },
    "JudicialAreaId": {
      "type": "string",
      "enum": [
        "antwerpen",
        "brussel",
        "gent",
        "liege",
        "mons"
      ],
      "description": "Id of a record in data/judicial-areas.json"
    },
    "Translated": {
      "type": "object",
      "properties": {
        "nl": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "nl",
        "fr",
        "de"
      ],
      "additionalProperties": false,
      "description": "A name in the three national languages"
    }
  }
}
