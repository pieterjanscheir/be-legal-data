{
    "name": "be-legal-data",
    "version": "0.2.0",
    "description": "Belgian legal reference data: courts, judicial cantons and arrondissements, municipalities, and legal and commercial interest rates.",
    "keywords": [
        "belgium",
        "belgian",
        "legal",
        "courts",
        "judicial-cantons",
        "arrondissements",
        "municipalities",
        "refnis",
        "interest-rates",
        "vredegerecht",
        "justice-of-the-peace"
    ],
    "license": "MIT AND CC-BY-4.0",
    "author": "Pieter-Jan Scheir",
    "homepage": "https://pieterjanscheir.github.io/be-legal-data/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pieterjanscheir/be-legal-data.git"
    },
    "bugs": {
        "url": "https://github.com/pieterjanscheir/be-legal-data/issues"
    },
    "type": "module",
    "packageManager": "pnpm@11.7.0",
    "engines": {
        "node": ">=22.12"
    },
    "sideEffects": false,
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./territory": {
            "types": "./dist/territory.d.ts",
            "default": "./dist/territory.js"
        },
        "./courts": {
            "types": "./dist/courts.d.ts",
            "default": "./dist/courts.js"
        },
        "./interest-rates": {
            "types": "./dist/interest-rates.d.ts",
            "default": "./dist/interest-rates.js"
        },
        "./data/*": "./data/*",
        "./schema/*": "./schema/*",
        "./datapackage.json": "./datapackage.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "data",
        "schema",
        "datapackage.json",
        "LICENSE-DATA"
    ],
    "scripts": {
        "build": "tsup",
        "build:cantons": "node scripts/build-cantons.ts",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "check": "pnpm generate && pnpm typecheck && pnpm lint && pnpm build && pnpm test:coverage && pnpm lint:package && git diff --exit-code -- schema src/ids.generated.ts",
        "prepublishOnly": "pnpm check",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "build:schemas": "node scripts/build-schemas.ts",
        "test:freshness": "vitest run --config vitest.freshness.config.ts",
        "lint:package": "publint --strict && attw --pack . --profile esm-only",
        "build:ids": "node scripts/build-ids.ts",
        "generate": "pnpm build:ids && pnpm build:schemas",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^3.2.7",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "ts-json-schema-generator": "^2.9.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.71.2",
        "vitepress": "^1.6.4",
        "vitest": "^3.2.0"
    }
}
