@font-face {
    font-family: 'Poppins';
    src: url('../font/Poppins/Poppins-Black.woff2') format('woff2'),
        url('../font/Poppins/Poppins-Black.woff') format('woff');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
}

