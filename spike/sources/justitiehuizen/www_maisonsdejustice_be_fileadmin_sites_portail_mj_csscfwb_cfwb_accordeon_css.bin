/****************************   ACCORDION   ******************************/

.cfwb-accordion > .cfwb-accordion-header {
  color: #444;
  cursor: pointer;
  padding: 5px;
  padding-left: 10px;
  width: calc(100%-5px);
  border-bottom: solid 1px #eee;
  text-align: left;
  outline: none;
  font-size: 15px;
  transition: 0.4s;
  position: relative;
}

.cfwb-accordion.active > .cfwb-accordion-header,.cfwb-accordion > .cfwb-accordion-header:hover {
  background-color: #ccc;
}

.cfwb-accordion > .cfwb-accordion-panel {
  padding: 0 18px;
  max-height: 0;
  background-color: white;
  overflow: hidden;
  transition: max-height 0.2s ease-out;
}


.cfwb-accordion > .cfwb-accordion-header:after {
  content: '\002B';
  color: #777;
  font-weight: bold;
  position: absolute;
  right: 15px;
  top: 50%;
  transform: translateY(-50%)
}

.cfwb-accordion.active > .cfwb-accordion-header:after {
  content: "\2212";
}

.cfwb-accordion > .cfwb-accordion-header:focus-visible {
  border: 2px solid #000;
}

.cfwb-accordion b, .cfwb-accordion strong{
  font-weight: 900;
}

.cfwb-accordion p{
  display: block;
  margin-top: 1em;
  margin-bottom: 1em;
  margin-left: 0;
  margin-right: 0;
}
