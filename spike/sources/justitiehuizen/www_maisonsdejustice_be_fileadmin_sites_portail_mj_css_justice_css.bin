 /*  APL */ 

tr{
border :thin solid;
}

/* Portrait tablet to landscape and desktop */
@media (max-width: 1200px) { 
.nomportail{
    width: 298px;
}
}

.sousmenu {
    border-bottom: 1px solid #cacaca;
    font-size: 0.65rem;
    line-height: 24px;
    text-transform: uppercase;
}
.breadcrumb {
    font-size: 0.65rem;
}
#contentnews article time {
    font-size: 0.6rem;
    padding-right: 3px;
}
article img {
    margin-top: 8px;
}
article h1 a {
    font: bold 0.7rem verdana,arial,sans-serif;
}
article p, article time, article span, #bioxpress p {
    font: 0.7rem verdana,arial,sans-serif;
}



