}



/* ***********CEPIGE*********** */

.slideshow a {
  text-decoration:none;
}
.slideshow ul.owl-carousel figure {
    
    padding: 2%;
}

.slideshow ul.owl-carousel .owl-pagination .owl-page span{
  border-color: #fff;
}

.slideshow ul.owl-carousel .owl-pagination .owl-page.active span{
  background-color: #fff;
}

.slideshow  .text-block h1 { 
    color: #fff;
    padding-bottom: 5px;
}


