.nomportail{
    font:1.250em drescher_grotesk_bt_smallsiRg,verdana,arial,sans-serif !important;
    line-height:75px !important;
    float:left;
    border-left:2px solid black;
    margin-left:60px;
    margin-top:35px;
    padding-left:60px;
}
.nomportail img{
    height:40px;
    margin-right:30px;
    line-height:40px;
    vertical-align:middle;
}
.slideshow{
    background-color:#be80b6;
}
.current, #navleft a:active,#content a:hover, #sectionright a:hover, #section a:active,.nomportail a:hover,.current a,#navleft a:hover,.footerthema a:hover{
    color:#91218d;
}
.articlejustice .article-content{
    background-image:none;
}
#centerportrait figcaption,#centerfocus figcaption,#pagecontent figcaption,#la-une{
    background-color:#ebd5ea;
}
#pagecartouche ul{
    border:0px solid #91218d;
}
#pagecartouche ul li {
    background: rgba(0, 0, 0, 0) url("../pictures/bullet.png") no-repeat scroll left 8px / 7px auto;
    font: 0.8rem/20px trebuchet ms;
}
.tx-smileglossary-pi1 h2.terme {
    color: #91218d;
}
