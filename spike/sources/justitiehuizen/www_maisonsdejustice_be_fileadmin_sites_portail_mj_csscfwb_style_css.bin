/******************** RESET ***************/
html,body{
    width:100%;
    font:1em verdana,arial,sans-serif;
    line-height:20px;
}
a{
    text-decoration:none;
    color:black;
}
.center,#content{width:1200px;
    margin:0 auto;
}
.clearboth{
    clear:both;
    float: none !important;
    display: block !important;
}
.center p sub {
font-size: .7em;
line-height: .8em;
} 
/************* HEADER ***************/

#extheader, #extheader .center {
    background-color:#d9d9d9;
    height:25px;  
    clear:both;  
}
#menuextheader{
    float:right;
}
header .center div, header .center p,header .center h1,.lang{
    font:0.85em DrescherGroteskBT-SmallSizes,verdana,arial,sans-serif;
    text-transform:uppercase;
    line-height:25px;
    vertical-align:middle;
    display:inline;
}
header .center h1, .lang, header .center p {
    font: 0.75em/25px DrescherGroteskBT-SmallSizes,verdana,arial,sans-serif;
}

header #extheader .center div, header .center p,.lang{
    margin-right:65px;
    float:right;
}
header #extheader .center #AddThis div{margin-right:0px;}

header #extheader .center .tx-solr{
  margin-right: 0px;
}
header #extheader .center .tx-solr-searchbox{
  margin-left: 5px;
  margin-right: 5px;
}
header .center:nth-of-type(2){
    border-bottom:2px solid black;
    margin-bottom:15px;
}
.lang li{
    display:inline-block;
    text-transform:uppercase;
}
.lang a{
    color:grey;
    float:none!important;
}
.lang .langactif a{
    color:black;
}
.tx-solr-searchbox{
    background-color:#d9d9d9;
    height:50px;
    text-align:center;
}
/*
#search_form{
    position:relative;
    border:0;
}
*/

#extheader .tx-solr form input {padding-top:0px;padding-bottom:0px;}
#extheader .tx-solr input.tx-solr-q {height:30px;}

#submit_search{
    width:30px;
    height:30px;
    /*position:absolute;*/
}
.psearch{
    width: 100%;
    margin-right: 0!important;
}
.psearch a{
    text-transform:none;
    margin:auto 8px auto 0;
    font:0.85em verdana,arial,sans-serif;
    float: none !important;
}
#inputText{
    height:30px;
    border:none;
    font:0.85em verdana,arial,sans-serif;
    text-transform:uppercase;
    padding-left:8px;
    width:90%;
  width: 185px;
}
.img_header_logo{
    margin:35px 0;
    float:left;
}

#AddThis {
  padding-right:50px;}

#AddThis div{
  margin-right: 5px;
  float:right;
}

.partage #AddThis {overflow: auto;}

.partage #AddThis li {list-style: none; float: left; margin-right: 5px;}

.partage #AddThis #moreAddThis a {width: 50px !important;}


/*.addthis_toolbox,.addthis_default_style{
    clear:both;
    margin-top:-25px;
    text-align:center;
}
.addthis_toolbox,.addthis_default_style img{
    border:0;
}
.at16nc, .at300bs, .at15nc, .at15t_facebook, .at16t_facebook{
    display:inline;
}*/
/*header .center a:first-child{
    display: inline-block;
    float: left;
}*/
/*************** CONTENU *************/
section#content{
    width:100%;
}
section#center,section#left, #navleft{
    float:left;
}
#sectionright{
    float:right;
}
#navleft,#sectionright{
    width:19.2%;
}
.annonces_gauche{
  width: 230px;
}
.bodytext i{
    font-style: italic;
}
#sectionright,#navleft{
}
#center{
    /*margin:0 1%;*/
    width:60.6%;
}
#navleft a:hover,#navleft a:active,#sectionright a:hover,#section a:active{
    color:rgba(0,0,0,0.5);
}
/************** NAV PORTAILS ***************/

header nav, footer + nav{
    height:40px;
    padding-bottom:15px;
    width:100%;
    clear:both;
}
header nav ul,footer + nav ul{
    display:inline-block;
    width:100%;
}
header nav ul li,footer + nav ul li{
    display:inline-block;
    font:0.85em DrescherGroteskBT-SmallSizes,verdana,arial,sans-serif;
    text-transform:uppercase;
    line-height:25px;
    text-align:center;
    border-left:1px solid black;
    padding-left:4%;
    background-size:25px;
}
header nav ul li a, footer + nav ul li a{
    vertical-align:middle;
    
}
header .center div.navresp,nav.center div.navresp{
    clear:both;
    margin-right:0;
}
#socialtoolbar {/*padding-right:40px;padding-top:0px;padding-left:40px;float:right; display: none;*/}
#socialtoolbar {margin-top:3px;}
#socialtoolbar a {padding:0px 4px;}

.navportail{
    width:15%;
    padding-left:0%;
    /*background:url('../pictures/mini_logo_enseignement.png') no-repeat 7% 50%; */
  border-left:none;
}

.navenseignement{
    width:13%;
    padding-left:0%;
    /*background:url('../pictures/mini_logo_enseignement.png') no-repeat 7% 50%; */
}
.navculture{
    width:10%;
    padding-left:0%;
    /*background:url('../pictures/mini_logo_culture.png') no-repeat 7% 50%; */
}
.navsport{
    width:12%;
    padding-left:0%;
    /*background:url('../pictures/mini_logo_sport.png') no-repeat 7% 50%; */
}

/*TEST JDU*/
.navsport a{
   white-space: nowrap;
}


.navjeunesse{
    width:14%;
    padding-left:0%;
    /*background:url('../pictures/mini_logo_jeunesse.png') no-repeat 7% 50%; */
}
.navrecherche{
    width:18%;
    padding-left:0%;
    /*background:url('../pictures/mini_logo_recherche.png') no-repeat 7% 50%; */
}
.navjustice{
    width:15%;
    padding-left:0%;
    /*background:url('../pictures/mini_logo_justice.png') no-repeat 7% 50%; */
}

.navresp_header .navenseignement{
  width:15%;
}
.navresp_header .navculture{
  width:12%;
}
.navresp_header .navsport{
  width:14%;
}
.navresp_header .navjeunesse{
  width:17%;
}
.navresp_header .navrecherche{
  width:21%;
}
.navresp_header .navjustice{
  width:18%;
}

.navportail a{
    background:url('../pictures/projet-portail-culture230OKnotes_20.jpg') no-repeat 0% 50%;
    padding:15px 0px 15px 30px;padding-right:150px;
}

.navenseignement a{
    background:url('../pictures/mini_logo_enseignement.png') no-repeat 0% 50%;
    padding:10px 0px 10px 30px;
}
.navculture a{
    background:url('../pictures/mini_logo_culture.png') no-repeat 0% 50%;
    padding:10px 0px 10px 30px;
}
.navsport a{
    background:url('../pictures/mini_logo_sport.png') no-repeat 0% 50%;
    padding:10px 0px 10px 30px;
}
.navjeunesse a{
    background:url('../pictures/mini_logo_jeunesse.png') no-repeat 0% 50%;
    padding:10px 0px 10px 30px;
}
.navrecherche a{
    background:url('../pictures/mini_logo_recherche.png') no-repeat 0% 50%;
    padding:10px 0px 10px 30px;
}
.navjustice a{
    background:url('../pictures/mini_logo_justice.png') no-repeat 0% 50%;
    padding:10px 0px 10px 30px;
}

footer + nav{
    padding-top:10px;
    line-height: 1;
}
nav.center ul{
    margin:10px auto;
    display:block;
}
/************** NAV LEFT **************/


/*a {
    color: #0066cc;
    text-decoration: underline;
}*/
a:hover{
    color:grey;
}
#navleft{
    width:230px;
    display:block!important;
}

/* supprimé par MMI 20150302 
#navleft #mainMenu{
  margin-top:15px;
}*/

.button_hidden{
    display:none;
}
.menu, .navsize:first-child{
    border-top:2px solid black;
    padding-bottom:50px;
    font-family:DrescherGroteskBT-SmallSizes,verdana,arial,sans-serif;
    padding-top: 0px;
    margin-top: 15px;
}
#navleft h2{
    line-height:50px;
    vertical-align:middle;
    font-weight:normal;
}
.navsize a{
    border-bottom: 1px solid #cacaca;
    display: block;
}
.menu:first-child,.navsize:first-child{
    border-top:none;
}

.sousmenu{
    border-bottom:1px solid #cacaca;
    text-transform:uppercase;
    line-height:24px;
  font-size: 0.65rem;
}
#navleft .sousmenu li:last-child a{
    border-bottom: none;
}
.sousmenu li{
    margin-left:15px;
}
.actif_navleft ul li{
    font-weight:normal;
    padding-left: 15px;
}
.actif_navleft ul li:last-child{
    border-bottom:1px solid #cacaca;
}
.current {
    background:url('../pictures/bullet.png') no-repeat scroll left top 7px / 7px auto rgba(0, 0, 0, 0);
    background-size:10px;
    padding-left: 13px;
    font-weight: bold;
    line-height: 2;
}
.current a{
  font-weight: normal;
}
.current > a, .actif_navleft{
    font-weight:bold;
}
.actif_navleft ul li.current {
    font-weight: bold;
}

#navleft .slicknav_menu .navsize:first-child{
  border: 0px;   
}

#navleft .slicknav_menu h2{
  font-size: 14px;
}

#navleft .slicknav_menu li {
  padding-bottom:0px;
}
#navleft .slicknav_menu li a {
  font-size: 12px;
  border-bottom:none;
}

#navleft .slicknav_menu ul {
  border-bottom:none;
}

/*********************** MENU DEROULANT ********************/

.button_hidden,.button_hidden + div{
    display:none;
}

#trigger-search{
  display:none;
}

#navleft .tx-solr{
  display:none;
}

.slicknav_menu {
  display:none;
  margin-right: 4em;
}

.icon-search:before{
  content: "";
}

.icon-search {
  font-family: icomoon;
  font-style: normal;
  font-variant: normal;
  font-weight: 400;
  line-height: 1;
  text-transform: none;
}
.tx-solr-q {
    border: 1px solid #cfcecf;
    padding: 5px;
    width: 80%;
}
#tx-solr-sorting {
    float: right;
    margin-right: 17px;
    margin-top: 3px;
}


/*********************** CONTENT CENTER *******************/
.slideshow{
    padding-bottom: 0px;
    width:98.35%;
    margin-bottom:30px;
    margin-top:15px;
    margin-left:12px;
}
div.owl-page{
    display:inline-block;
    cursor:pointer;
}
div.owl-page.active span{
    background-color:black;
}
.owl-page span{
    display:block;
    width:12px;
    height:12px;
    margin:0 7px;
    border:1px solid black;
    border-radius:20px;
    webkit-border-radius:20px;
    -moz-border-radius: 20px;
}
.owl-pagination {
    display: block;
    position: relative;
    top: -25px;
}
.slidecontent img{
    width:80%;
    margin: 0 auto;
}
.slideshow ul.slides,#center .slideshow ul.slides figure{
  width:100%;  
  /* supprimé par mmi 20150302 
  padding-bottom: 15px; */
}
.slideshow ul.slides div.text-block,#center .slideshow ul.slides figcaption{
  padding:5px;
  min-width:30%;
  display:inline;
}
.slideshow ul.slides img {
  height:auto;
  float:left;
  width: 100%;
  margin-right: 10px;
}
#center .slideshow ul.slides figcaption p {
    padding-left: 15px;
}
.slider_design_0{
  color:black;
}

.slider_design_1{
  color:black;
}

.slider_design_2{
  color:black;
}
.slideshow ul.slides figure{
  margin-bottom: -35px;
  margin-top: 0;
  padding: 0;
}
.slideshow{
background-color:#cacaca;
}
div .owl-controls{
float:right;}

/************************* ARTICLES ******************/
.theme{
  float: left;
  font-size: 0.85em;
}
#contentnews{
    width:100%;
}
#pagefocus p i {
    font-style: italic;
}
article{
    width:230px;        
    float:left;
    margin-bottom:10px;
    margin-left:12px;
}

article .article-content{
  padding:10px;
}

#contentnews article time{
    float:right;
    text-align: right;
    font-size: 0.6rem;
    padding-right: 3px;
}
article h2 {
        font-family: DrescherGroteskBT-SmallSizes
}
article img{
    width:auto;
    clear:both;
  margin-top: 8px;
}
.tx-cfwbarticlefe #contentnews-intern a img{
    width: 210px;
}

/* supprimé par mmi 20150302
.tx-cfwbarticlefe article#pagecontent {
  padding-top:20px;
} */

.tx-cfwbarticlefe ol {list-style:decimal;}

article p, article time,article span,#bioxpress p{
    font: 0.7rem verdana,arial,sans-serif;
    /*font: 0.7rem trebuchet ms; */
    line-height:20px;
}

a article {
    font:0.75em verdana,arial,sans-serif;
}
a article h1 {
    font:0.9em verdana,arial,sans-serif;
    font-weight:bold;
}
article p{
    margin-bottom:0;
}
.partage{
  float:right;
  margin-top: 5px;
}
.articleenseignement .article-content{
    background:url('../pictures/mini_logo_enseignement.png') no-repeat 5px 5px rgba(42,110,204,0.2);
    background-size:20px;
}
.articleenseignement a:nth-of-type(2),.articleenseignement h1 a:hover,.articleenseignement h1 a:active,.navenseignement a:hover{
    color:#2a6ecc;
}
.articleculture .article-content{
    background:url('../pictures/mini_logo_culture.png') no-repeat 5px 5px rgba(231,0,51,0.2);
    background-size:20px;
}
.articleculture a:nth-of-type(2),.articleculture h1 a:hover,.articleculture h1 a:active,.navculture a:hover{
    color:#e70033;
}
.articlesport .article-content{
    background:url('../pictures/mini_logo_sport.png') no-repeat 5px 5px rgba(255,91,0,0.2);
    background-size:20px;
}
.articlesport a:nth-of-type(2),.articlesport h1 a:hover,.articlesport h1 a:active,.navsport a:hover{
    color:#ff5b00;
}
.articlejeunesse .article-content{
    background:url('../pictures/mini_logo_jeunesse.png') no-repeat 5px 5px rgba(61,155,53,0.2);
    background-size:20px;
}
.articlejeunesse a:nth-of-type(2),.articlejeunesse h1 a:hover,.articlejeunesse h1 a:active,.navjeunesse a:hover{
    color:#3d9b35;
}
.articlerecherche .article-content{
    background:url('../pictures/mini_logo_recherche.png') no-repeat 5px 5px  rgba(0,163,171,0.2);
    background-size:20px;
}
.articlerecherche a:nth-of-type(2),.articlerecherche h1 a:hover,.articlerecherche h1 a:active,.navrecherche a:hover{
    color:#00a3ab;
}
.articlejustice .article-content{
    background:url('../pictures/mini_logo_justice.png') no-repeat 5px 5px rgba(145,33,141,0.2);
    background-size:20px;
}
.articlejustice a:nth-of-type(2),.articlejustice h1 a:hover,.articlejustice h1 a:active,.articlejustice h1 a:hover,.navjustice a:hover{
    color:#91218d;
}

.articledefault .article-content{
    background-color:rgba(0,0,0,0.2);
}
.articledefault a{
    color:black;
}
.articledefault a:hover{
    color:gray;
}

article p a{
  font: 0.75rem verdana,arial,sans-serif;
    text-decoration: underline;
    color: #0066cc;
}
article ul a{
  font: 0.75rem verdana,arial,sans-serif;
    text-decoration: underline;
    color: #0066cc;
}
article span a{
  font: 0.75rem verdana,arial,sans-serif;
    text-decoration: underline;
    color: #0066cc;
}
article a .articlejeunesse masonryitem {
    margin: 0;
}
.articlejeunesse masonryitem a {
  color: 3d9b35;
}

.link_articles {margin-left:12px;padding-top:10px;}
.link_articles a {font: 0.85rem verdana,arial,sans-serif;;}

.logoenseignement{
    background:url('../pictures/mini_logo_enseignement.png') no-repeat 5px 5px ;
    background-size:20px;
}

.logoculture{
    background:url('../pictures/mini_logo_culture.png') no-repeat 5px 5px;
    background-size:20px;
}

.logosport{
    background:url('../pictures/mini_logo_sport.png') no-repeat 5px 5px;
    background-size:20px;
}

.logojeunesse{
    background:url('../pictures/mini_logo_jeunesse.png') no-repeat 5px 5px ;
    background-size:20px;
}

.logorecherche{
    background:url('../pictures/mini_logo_recherche.png') no-repeat 5px 5px;
    background-size:20px;
}

.logojustice{
    background:url('../pictures/mini_logo_justice.png') no-repeat 5px 5px ;
    background-size:20px;
}

/******************** SECTION RIGHT ***********************/

#sectionright div{
    padding-bottom: 0px;
    margin-top: 0px;
    border-top: none;
}
/* en principe plus besoin 10/10/14 mmi */
/* #sectionright div:first-child{
    border-top: medium none;
    font-size: 0.95em;
  margin-top: 15px;
}*/

#sectionright .modules, #sectionright #modules, #sectionright #la-une {
  border-top: 2px solid black; 
/* mis en commentaire par mmi 20150302
   margin-top: 15px; */
}

#sectionright .annonces, #sectionright #annonces {
  margin-top: 15px;
  border-top: 2px solid black; 
}

#sectionright .csc-frame-frame1{
  margin-top: 15px;
  border-top: 2px solid black; 
}

#sectionright #liensthema, #sectionright #actuother, #sectionright #archive{
  margin-top: 15px;
  border-top: 2px solid black; 
}

#la-une{
    /*height:490px;*/
}

#sectionright h2{
    font-family:DrescherGroteskBT-SmallSizes,verdana,arial,sans-serif;
  /* border-top: 2px solid black; */
    font-size: 1rem;
    margin: 5px 0;
}
#sectionright h3{
    text-transform:uppercase;
    font-size: 0.7em;
}
.telnumber{
    color:green;
    font-size:1em;
    font-weight:bold;
    letter-spacing:1px;
}
#sectionright #question p{
    color: #b2b2b2;
    font-size: 0.8em;
}
#sectionright h2{
    margin:10px 0 0;
  padding-top: 10px;
}
#newsletter form{
    padding:5px;
    background-color:rgba(0,0,0,0.1);
}
#newsletter input[type="submit"]{
    margin:10px 0;
}
#sectionright li{
  background-size:10px;
  /*background: url("../pictures/bullet.png") no-repeat scroll left 6px top 17px / 7px auto rgba(0, 0, 0, 0);*/
  background: none;
  border-bottom: 1px dotted #ffffff;
  font-size: 0.7em;
  min-height: 25px;
  padding: 10px 0 10px 0px;
}
.annonces div{
    border-top:none;
}
.annonces div a img{
    width:100%;
}
/******************* SECTION IMAGE ****************/
.sectionimg{
    clear:both;
    width:100%;
    line-height:115px;
}
/* supprimé par MMI car plus besoin. Le logo du MFW-B se retrouve en bas */
/*.sectionimg img{
    vertical-align:middle;
    display:inline-block;
} */
.sectionimg .up{
    display: inline-block;
    float: right;
    width:19.2%;
}
/*********************** PAGE PORTRAIT/FOCUS/CONTENT/CARTOUCHE ******************/
#centerportrait,#centerfocus{
    float:left;
    margin:0 1%;
    padding-top:10px;
}
.chapeau{
    font-weight: normal !important;
    margin-top:20px;
    font-size:0.9em;
    margin-bottom:10px;
}
figure{
  margin-top: 40px;
}
#centerportrait figcaption,#centerfocus figcaption,#pagecontent figcaption{
    background-color:#cacaca;
    margin-top:-3px;
}
#centerportrait figure img,#centerfocus figure img,#pagecontent figure img{
    margin-bottom:0;
    width:100%;
    clear:both;
    padding-top: 25px; 
}
/* mmi ajout le 05/02/2015 */
#pagecontent figure {  margin-top:10px;
}

#centerportrait figcaption,#centerfocus figcaption,#pagecontent figcaption{
    font-size:0.85em;
}
#pagecontent > h1,#centerfocus > h1,#centerportrait > h1,#pagecartouche > h1,#solrsearch > h1{
    font: 1.3em DrescherGroteskBT-SmallSizes,verdana,arial,sans-serif;
    margin-top: 17px;
    padding-left: 10px;
}
article h1 {
    font-size: 0.8rem;
    font-weight: bold;
    line-height: 1rem;
    margin: 12px 0;
}
article h1 a {
    font: bold 0.7rem verdana,arial,sans-serif;
}
#centerportrait p,#centerfocus p{
    text-align: justify;
}
#pagecontent time,#centerportrait time,#centerfocus time{
    display:inline-block;
    float: right;
    font-size:0.85em;
}
#pagecontent ul {
  list-style : disc outside none;
  margin-bottom: 12px;
    margin-top: 12px;
    padding-left: 40px;
}
#liensthema h2,#la-une h2,#portraitother h2,#bioxpress h2,#focusother h2,#focusplus h2,#actuother h2,#archive h2{
    border-bottom:1px solid #000;
    line-height:44px;
    vertical-align:middle;
    font-size:1.2em;
    margin:0;
}
#pagecontent{
    width:auto;
    padding:0;
    margin-top:10px;
}
#pageportrait,#pagefocus{
  width:60%;
  padding:0;
  margin-top:0px;
}
#bioxpress,#focusplus{
    width:33%;
    float:left;
    border-top:2px solid black;
    margin-left: 2%;
    margin-top:20px;
    margin-bottom: 10px;
}

#bioxpress em{
    font-weight:bold;
}
#la-une div{
    background-color:#cacaca;
    border-top:none;
    padding:4px;
}
#la-une img{
    width:60%;
}
#la-une time{
    font-size:0.7em;
    float:right;
}
#la-une a{
    text-decoration: none;
}

