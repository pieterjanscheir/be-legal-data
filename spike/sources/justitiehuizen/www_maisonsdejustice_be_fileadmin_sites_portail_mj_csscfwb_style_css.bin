#before_content_block .submenu li a {
    display: block;
}
#before_content_block .submenu {
    background-color: #ececec;
    clear: both;
    color: #76848c;
    float: left;
    height: 1%;
    list-style: none outside none;
    margin: 0 0 15px;
    padding: 4px 0;
    width: 99%;
}
#before_content_block .submenu li {
    background: none repeat scroll 0 0 rgba(0, 0, 0, 0);
    display: block;
    float: left;
    margin: 0;
    padding: 8px 0;
    width: 99%;
}
#before_content_block .submenu li a {
    color: #c81d1b;
    padding: 0 8px 0 26px;
}
#before_content_block .submenu li a:visited {
    color: #704588;
}
#before_content_block {
    clear: both;
    color: #4a4a4a;
    float: left;
    height: 1%;
    overflow: visible;
    padding: 0 23px;
    width: 99%;
}
#before_content_block h2 {
    clear: both;
    color: #76848c;
    display: block;
    float: left;
    font-size: 16px;
    font-weight: bold;
    margin: 10px 0 15px;
    padding: 0;
    text-transform: uppercase;
}
#before_content_block h3 {
    clear: both;
    color: #7797a9;
    display: block;
    float: left;
    font-size: 12px;
    font-weight: bold;
    margin: 10px 0 15px;
    padding: 0;
    text-transform: uppercase;
}
#before_content_block h4 {
    color: #7797a9;
    display: block;
    font-size: 11px;
    font-weight: normal;
    margin: 10px 0 15px;
    padding: 0;
    text-transform: uppercase;
}
#before_content_block ul {
    clear: both;
    float: left;
    list-style: none outside none;
    margin: 3px 0;
    padding: 0 0 0 75px;
}
#before_content_block li {
    margin: 0;
    padding: 0 0 0 11px;
}
#before_content_block p {
    clear: both;
    margin: 10px 0;
    padding: 0;
    width: 99%;
}
#before_content_block .content_hat {
    clear: both;
    margin-bottom: 0;
    padding-bottom: 0;
}
#before_content_block {
    clear: both;
    color: #4a4a4a;
    float: left;
    padding: 0 23px;
    width: 99%;
}
#before_content_block .submenu ul {background-color:#fff;}
#before_content_block .submenu li a {border-left: 0px solid #B6B6B6;}
#before_content_block ul.submenu li { background:url(../pictures//main_ctnt_itm_space_02_chip.png) 8px 10px no-repeat; }
#before_content_block .submenu {background-color:#fff; border: 1px solid #4a637d;width:99%;}
#before_content_block ul.submenu li {background:transparent url(../pictures//puces_liste.jpg) no-repeat scroll 5px 10px;margin:0px 10px 0px 8px;width: 31%;}
#before_content_block ul.submenu li a {padding : 0 0 0 0;color:#000;font-size:1em;padding:0 0 0 22px;}
#before_content_block ul.submenu li a:visited {padding : 0 0 0 0;color:#1e495c;font-size:1em;padding:0 0 0 22px;}
