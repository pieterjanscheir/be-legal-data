ul.list-custom{
  display: block;
  padding-left: 10px !important;
  font: 0.8rem/20px trebuchet ms;
}

ul.list-custom li{
  list-style-type: none !important;
  background: transparent !important;
  background-image:none !important;
}

ul.list-custom li:before{
  content: "\2022";  
  color: #000; 
  font-weight: bold; 
  display: inline-block; 
  width: 1em; 
  margin-left: -1em;
}

ul.list-custom li::marker {
    content: none;
}

.frame-custom-grey{
    width: 80%;
    border: 1px solid black;
    padding: 10px;
    margin: auto;
    margin-bottom: 15px;
    background-color: #f5f5f5;
}

.btn-custom-blue{
  font-family: "roboto";
  border: 0px solid #1533db;
  padding: 15px;
  border-radius: 15px;
  background-color: #0956c8;
  display: inline-block;
  text-decoration: none !important;
  color: #fff !important;
  transition-duration: .5s;
  font-size: 16px;
}

.btn-custom-blue:hover{
  background-color: #0e2397;
}

.align-center{
  text-align: center;
}


.indent
{ padding-left:30px;}

.default-css p{
  display: block;
  margin-top: 1em;
  margin-bottom: 1em;
  margin-left: 0;
  margin-right: 0;
}